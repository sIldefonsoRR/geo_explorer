{
  "name": "geo-explorer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.mjs",
    "prerender": "node scripts/prerender.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom.cdx.json",
    "sbom:check": "node scripts/check-sbom.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "csv-parse": "^5.5.6",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
